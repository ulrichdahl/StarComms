# ---- Fleet tokens ----
# One env var per Discord application, named by `token_env:` in
# config/fleet.yaml. Tokens are shown once in the developer portal; store
# them here, never in the yaml. Every application also needs SERVER
# MEMBERS enabled in the portal — a login with that intent bit but the
# toggle off fails with DisallowedIntents.
SB_TOKEN_CONTROLLER=
SB_TOKEN_ALFA=
SB_TOKEN_BRAVO=
SB_TOKEN_CHARLIE=

# Paths. Defaults suit local dev; docker-compose.yml overrides them
# to /etc/starcomms/fleet.yaml and /data/starcomms.db.
# CONFIG_PATH=config/fleet.yaml
# DB_PATH=data/starcomms.db

# /healthz listener. Internal only, never published from the container.
STATUS_PORT=3000

# ---- Receive spike ----
# The step-1 spike survives across the pivot as a DAVE-decrypt smoke
# test — `npm run spike`. Only used when running the spike directly.
SPIKE_TOKEN=
SPIKE_GUILD_ID=
SPIKE_CHANNEL_ID=
SPIKE_RUN_SECONDS=0
SPIKE_PORT=3000
SPIKE_MIN_PACKETS=25
SPIKE_MIN_RMS=0.005
