# ---- step 1 receive spike (§16.1) ----
# One fleet application is enough to run the spike.
# Required scopes on the invite: bot
# Required permissions: View Channel, Connect
# Required privileged intent (developer portal): SERVER MEMBERS
SPIKE_TOKEN=
SPIKE_GUILD_ID=
SPIKE_CHANNEL_ID=

# 0 = run until Ctrl-C. >0 = auto-exit with a verdict after N seconds.
SPIKE_RUN_SECONDS=0

# /healthz listener. Internal only, never published from the container.
SPIKE_PORT=3000

# Verdict thresholds — a speaker must clear all three to count as proof.
SPIKE_MIN_PACKETS=25
SPIKE_MIN_RMS=0.005

# ---- later steps ----
# DB_PATH=/data/starbridge.db
# CONFIG_PATH=/etc/starbridge/fleet.yaml
# STT_URL=http://stt:8000/v1
