# ---- step 1 receive spike (§16.1) ----
# One fleet application is enough to run the spike.
# Required scopes on the invite: bot
# Required permissions: View Channel, Connect
# Required privileged intent (developer portal): SERVER MEMBERS
SPIKE_TOKEN=
SPIKE_GUILD_ID=
SPIKE_CHANNEL_ID=

# 0 = run until Ctrl-C. >0 = auto-exit with a verdict after N seconds.
SPIKE_RUN_SECONDS=0

# /healthz listener. Internal only, never published from the container.
SPIKE_PORT=3000

# Verdict thresholds — a speaker must clear all three to count as proof.
SPIKE_MIN_PACKETS=25
SPIKE_MIN_RMS=0.005

# ---- step 2 fleet manager (§16.2), 4-bot layout ----
# One env var per Discord application, named by `token_env:` in config/fleet.yaml.
# Tokens are shown once in the developer portal; store them here and nowhere
# in the yaml. Every application also needs SERVER MEMBERS enabled — a login
# with that intent set but the toggle off fails with DisallowedIntents.
#
# The controller is a separate application from the squad (see CLAUDE.md
# "Divergence from spec"). Reusing the step-1 spike bot as the controller is
# the natural choice — set SB_TOKEN_CONTROLLER to the same value as
# SPIKE_TOKEN below.
SB_TOKEN_CONTROLLER=
SB_TOKEN_ALFA=
SB_TOKEN_BRAVO=
SB_TOKEN_CHARLIE=

# Paths. Defaults suit local dev; docker-compose.yml overrides them.
# CONFIG_PATH=config/fleet.yaml
# DB_PATH=data/starbridge.db

# /healthz listener. Internal only, never published from the container.
STATUS_PORT=3000

# ---- step 3 blind relay (§16.3) ----
# Two voice-channel IDs in the guild alfa/bravo/charlie are all in. Bravo
# joins the source and listens; charlie joins the target and transmits every
# non-fleet speaker as raw opus (no cues, no STT, no callsign detection —
# that arrives in step 6). Leave both blank to keep the fleet up without the
# relay (useful for gateway/intents diagnosis without touching voice channels).
RELAY_SOURCE_CHANNEL_ID=
RELAY_TARGET_CHANNEL_ID=

# ---- step 6a detection (§16.6) ----
# STT_DRIVER selects the transcription backend.
#   'fake'          — canned response (STT_FAKE_RESPONSE). Boots with no
#                     sidecar; useful for verifying the audio → transcript
#                     pipeline lights up.
#   'whisper_local' — POSTs each utterance to a Speaches (faster-whisper-
#                     server) sidecar. Bring it up with
#                     `docker compose --profile stt up`. Falls back to
#                     fake if the sidecar is not reachable at boot.
STT_DRIVER=fake
STT_FAKE_RESPONSE=command alpha
STT_URL=http://stt:8000/v1
# STT_MODEL=Systran/faster-whisper-tiny   # override the model speaches loads
# STT_LANGUAGE=en                          # BCP-47; omit for autodetect
